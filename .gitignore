# claude-memory-compiler tool (its own git repo + runtime artifacts)
claude-memory-compiler/

# vendored everything-claude-code plugin (available as opt-in local marketplace)
tools/everything-claude-code/

# Local Claude Code settings
.claude/settings.local.json

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node / Next.js
node_modules/
ui/web/.next/
ui/web/next-env.d.ts
*.tsbuildinfo

# Env & data artifacts
examples/bi/*.db
.env
data/*
!data/.gitkeep

# Autonomous agent file workspace (bind-mounted in docker-compose)
/agent_workspace/

# macOS
.DS_Store

# Coverage artifacts (the CI job uploads its HTML report as a build artifact)
.coverage
.coverage.*
coverage.xml
htmlcov/
