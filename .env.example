# Enterprise AI Agent Workbench — environment template (copy to .env)
WB_ENV=dev
WB_LOG_LEVEL=INFO

# Storage
# Postgres password for the docker-compose stack. Default keeps the local demo
# zero-config; override in any non-local environment (the compose DSNs follow it).
WB_PG_PASSWORD=workbench
WB_POSTGRES_DSN=postgresql://workbench:workbench@localhost:5432/workbench
# Redis password — empty by default (local demo). REQUIRED in any non-local
# environment, especially with WB_JOB_BACKEND=redis (the job queue lives in Redis).
# When set, include it in WB_REDIS_URL too: redis://:<pass>@host:6379/0
WB_REDIS_PASSWORD=
WB_REDIS_URL=redis://localhost:6379/0
WB_QDRANT_URL=http://localhost:6333

# Background jobs: "inprocess" (default) runs jobs in the gateway; "redis" enqueues
# to Redis for a separate worker (make up-distributed / make worker).
WB_JOB_BACKEND=inprocess

# Observability trace store (Sprint 5). Default sqlite file works without Docker;
# `make up` overrides this to Postgres. Must be an async SQLAlchemy URL.
# On Postgres the schema is managed by Alembic: `make migrate`.
# WB_TRACE_DB_URL=sqlite+aiosqlite:///data/traces.db
# WB_TRACE_DB_URL=postgresql+asyncpg://workbench:workbench@localhost:5432/workbench

# Gateway hardening (off by default; set before exposing to a network)
# WB_API_KEY=                       # require X-API-Key on /v1/*
# WB_RATE_LIMIT_PER_MIN=60          # cap POST /v1/* per client IP per minute
# WB_APPROVAL_TOKEN=                # require X-Approval-Token on workflow approve/reject

# Tool Gateway MCP client: when set, the deep-research agent sources its tools from
# a real MCP server over stdio instead of the in-process corpus connectors.
# WB_MCP_SERVER_COMMAND=python -m workbench_toolgateway.mcp_server

# --- Model routing (ADR-003 + ADR-008) ---
# Local tier: Ollama on the RTX 4090 box. From this machine use its LAN IP,
# e.g. http://192.168.1.50:11434 (run `OLLAMA_HOST=0.0.0.0 ollama serve` there).
WB_LOCAL_LLM_BASE_URL=http://localhost:11434
WB_LOCAL_LLM_MODEL=qwen2.5:3b-instruct
# After pulling a 14B+ model on the 4090, point WB_LOCAL_LLM_MODEL at it and enable:
# WB_ROUTE_STANDARD_VIA_LOCAL=true

# RAG embeddings (run on the 4090 via Ollama: `ollama pull nomic-embed-text`).
# "hash" is a non-semantic dev fallback when the GPU box is unreachable.
# WB_EMBEDDINGS_BACKEND=ollama
# WB_EMBEDDING_MODEL=nomic-embed-text

# Model overrides per provider (defaults in workbench_shared/config.py)
# WB_DEEPSEEK_MODEL=deepseek-chat
# WB_KIMI_MODEL=kimi-k2-0905-preview
# WB_ANTHROPIC_MODEL=claude-opus-4-8
# WB_ANTHROPIC_SMALL_MODEL=claude-haiku-4-5
# WB_OPENAI_MODEL=gpt-5.1

# API keys (standard names; a provider is enabled when its key is set)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=        # Kimi
# Mimo is opt-in: set both the OpenAI-compatible endpoint and the key
# WB_MIMO_BASE_URL=
# WB_MIMO_MODEL=
# MIMO_API_KEY=
