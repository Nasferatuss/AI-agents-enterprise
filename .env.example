# Enterprise AI Agent Workbench — environment template (copy to .env)
WB_ENV=dev
WB_LOG_LEVEL=INFO

# Storage
WB_POSTGRES_DSN=postgresql://workbench:workbench@localhost:5432/workbench
WB_REDIS_URL=redis://localhost:6379/0
WB_QDRANT_URL=http://localhost:6333

# --- Model routing (ADR-003 + ADR-008) ---
# Local tier: Ollama on the RTX 4090 box. From this machine use its LAN IP,
# e.g. http://192.168.1.50:11434 (run `OLLAMA_HOST=0.0.0.0 ollama serve` there).
WB_LOCAL_LLM_BASE_URL=http://localhost:11434
WB_LOCAL_LLM_MODEL=qwen2.5:3b-instruct
# After pulling a 14B+ model on the 4090, point WB_LOCAL_LLM_MODEL at it and enable:
# WB_ROUTE_STANDARD_VIA_LOCAL=true

# Model overrides per provider (defaults in workbench_shared/config.py)
# WB_DEEPSEEK_MODEL=deepseek-chat
# WB_KIMI_MODEL=kimi-k2-0905-preview
# WB_ANTHROPIC_MODEL=claude-opus-4-8
# WB_ANTHROPIC_SMALL_MODEL=claude-haiku-4-5
# WB_OPENAI_MODEL=gpt-5.1

# API keys (standard names; a provider is enabled when its key is set)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=        # Kimi
# Mimo is opt-in: set both the OpenAI-compatible endpoint and the key
# WB_MIMO_BASE_URL=
# WB_MIMO_MODEL=
# MIMO_API_KEY=
